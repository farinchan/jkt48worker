NODE_ENV=production

STREAM_URL=https://your-worker-domain.workers.dev/playback

POLL_INTERVAL_MS=10000
REQUEST_TIMEOUT_MS=10000
MAX_CONSECUTIVE_FAILURES=3

RECORDINGS_DIR=./recordings
DATA_DIR=./data
LOG_DIR=./logs
CREDENTIALS_DIR=./credentials

TIMEZONE=Asia/Jakarta

# Path to ffmpeg and ffprobe (or leave as 'ffmpeg' if in PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

MIN_RECORDING_SIZE_BYTES=1048576
MIN_FREE_DISK_GB=20

# Google Drive folder ID to upload into (optional, leave empty for Drive root)
GOOGLE_DRIVE_FOLDER_ID=

# Resumable upload retry settings (0 = unlimited retries)
GOOGLE_UPLOAD_RETRY_INITIAL_MS=10000
GOOGLE_UPLOAD_RETRY_MAX_MS=600000
GOOGLE_UPLOAD_MAX_RETRIES=0

# YouTube Auto-Upload Settings
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_PRIVACY_STATUS=unlisted
YOUTUBE_TITLE_TEMPLATE=JKT48 Live Stream - {date}
YOUTUBE_DESCRIPTION_TEMPLATE=Recorded automatically by JKT48 Stream Auto-Recorder\nDate: {date}\nResolution: {resolution}
YOUTUBE_CATEGORY_ID=24
YOUTUBE_DEFAULT_TAGS=JKT48,Live,Stream,Theater,Showroom,IDN
YOUTUBE_MADE_FOR_KIDS=false

SHUTDOWN_TIMEOUT_MS=30000

SEGMENT_RECORDINGS=false
SEGMENT_DURATION_SECONDS=3600

LOG_LEVEL=info

DRY_RUN=false

# Web Management Dashboard Settings
WEB_ENABLED=true
WEB_PORT=60021
WEB_PASSWORD=admin

# Telegram Bot Notification Settings
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
